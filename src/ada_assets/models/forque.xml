<!-- Forque: graspable F/T sensor + fork assembly.

     Standalone freejoint object — the JACO2 picks it up with its fingers.
     A weld constraint attaches it to the hand at runtime (grasp_site).

     Kinematic chain (all transforms from ada_ros2 forque.xacro):
       fork_base (freejoint) — FTArmMount, grasp/weld point
         └─ ft_mount (fixed, xyz=[0, 0, -0.005])
              └─ fork_handle (fixed, xyz=[0, 0.005, 0.0013], slight rpy correction)
                   └─ forque_sensor (fixed, xyz=[-0.00634, -0.222553, -0.004286], rpy=[π/2, π/3, 0])
                        └─ fork_tine (fixed, xyz=[-0.0054, 0.008, 0.093], rpy=[0, π, 240°])
                             └─ fork_tip (site)

     All meshes at scale 0.001 (STL files are in mm).
     All transforms verified against the xacro. -->
<mujoco model="forque">

  <default>
    <default class="forque_visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="forque_collision">
      <geom type="mesh" contype="1" conaffinity="1" group="3"
            rgba="0.3 0.5 0.3 0.2"/>
    </default>
  </default>

  <asset>
    <material name="abs_plastic" rgba="0.25 0.25 0.25 1" specular="0.15" shininess="0.1"/>
    <material name="ati_aluminum" rgba="0.45 0.47 0.50 1" specular="0.6" shininess="0.4" reflectance="0.1"/>
    <material name="fork_steel" rgba="0.75 0.75 0.78 1" specular="0.8" shininess="0.7" reflectance="0.2"/>
    <mesh name="ft_arm_mount" file="2024_01_18_FTArmMount.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ft_mount" file="2024_01_18_FTMount.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ft_electronics" file="2023_03_09_wirelessFT.stl" scale="0.001 0.001 0.001"/>
    <mesh name="fork_handle" file="2024_06_24_forkHandleHollow.stl" scale="0.001 0.001 0.001"/>
    <mesh name="fork_handle_cover" file="2024_06_24_forkHandleCover.stl" scale="0.001 0.001 0.001"/>
    <mesh name="ft_sensor_body" file="ATI-9105-TW-NANO25-E.stl" scale="0.001 0.001 0.001"/>
    <mesh name="fork_tine" file="fork_tine.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <body name="fork_base">
      <freejoint name="fork_freejoint"/>
      <!-- FTArmMount inertial from xacro (mass=0.03783, cog from ada.xacro) -->
      <inertial pos="0.010957 -0.019223 -0.03777" mass="0.03783"
                fullinertia="0.000018817 0.0000039478 0.000019505 -0.0000003327 -0.000000092476 -0.0000040684"/>
      <geom class="forque_visual" mesh="ft_arm_mount" material="abs_plastic"/>
      <geom class="forque_collision" mesh="ft_arm_mount"/>
      <site name="grasp_site" pos="0 0 0" size="0.005" rgba="0 1 0 0.5"/>

      <!-- FTMount + FT electronics: xyz=[0, 0, -0.005] -->
      <body name="ft_mount" pos="0 0 -0.005">
        <inertial pos="0.010934 -0.138522 -0.05066" mass="0.103"
                  fullinertia="0.00017623 0.000068428 0.00021455 0.00000095729 -0.0000000562908 -0.00001757133"/>
        <geom class="forque_visual" mesh="ft_mount" material="abs_plastic"/>
        <geom class="forque_collision" mesh="ft_mount"/>
        <!-- FT wireless electronics (visual only, same origin as ft_mount) -->
        <geom class="forque_visual" mesh="ft_electronics" material="abs_plastic"/>

        <!-- forkHandle + cover: xyz=[0, 0.005, 0.0013], rpy=[-0.025, 0, -0.0065]
             Slight rotation from empirical deformation when gripped (per xacro comment). -->
        <body name="fork_handle" pos="0 0.005 0.0013"
              quat="0.999917 -0.012500 0.000041 -0.003250">
          <inertial pos="0.011097 -0.162629 -0.011948" mass="0.028"
                    fullinertia="0.00003114 0.000011867 0.000038478 -0.00000050626 0.000000082271 0.00000054005"/>
          <geom class="forque_visual" mesh="fork_handle" material="abs_plastic"/>
          <geom class="forque_collision" mesh="fork_handle"/>
          <!-- Handle cover (visual only, same origin as fork_handle) -->
          <geom class="forque_visual" mesh="fork_handle_cover" material="abs_plastic"/>

          <!-- ATI-9105-TW-NANO25-E sensor body: xyz=[-0.00634, -0.222553, -0.004286]
               rpy=[π/2, π/3, 0] = quat=[0.612372, 0.612372, 0.353553, -0.353553] -->
          <body name="forque_sensor" pos="-0.00634 -0.222553 -0.004286"
                quat="0.612372 0.612372 0.353553 -0.353553">
            <inertial pos="0.0124692 0.0137169 0.010558" mass="0.0634"
                      fullinertia="0.000005235822 0.000006264852 0.00000640797 -0.0000003129932 0.000000013798 -0.00000004033694"/>
            <geom class="forque_visual" mesh="ft_sensor_body" material="ati_aluminum"/>
            <geom class="forque_collision" mesh="ft_sensor_body"/>

            <!-- TODO: ft_sensor_site position needs to be verified against the
                 ATI Nano25-E gage origin from the datasheet drawing. Current
                 pos="0 0 -0.009" is the mesh midplane, not the actual sensing
                 reference point. -->
            <site name="ft_sensor_site" pos="0 0 -0.009" size="0.005" rgba="0 0 1 0.5"/>

            <!-- Fork tine: xyz=[-0.0054, 0.008, 0.093]
                 rpy=[0, π, 240°] = quat=[0, -0.866025, -0.5, 0] -->
            <body name="fork_tine" pos="-0.0054 0.008 0.093"
                  quat="0.000000 -0.866025 -0.500000 0.000000">
              <inertial pos="0.013090 0.0180789 0.0445231" mass="0.024"
                        fullinertia="0.0000098769 0.000009848103 0.0000015674 0.000000000806182 -0.00000000296036 0.00000057639"/>
              <geom class="forque_visual" mesh="fork_tine" material="fork_steel"/>
              <geom class="forque_collision" mesh="fork_tine"/>

              <!-- Fork tip — feeding contact point. -->
              <site name="fork_tip" pos="0.0135 0.007 0"
                    quat="0.000000 1.000000 0.000000 0.000000"
                    size="0.003" rgba="1 0 0 1"/>
            </body>

          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- ATI Nano25-E F/T sensor (SI-125-3 calibration).
       Fx,Fy ±125 N, Fz ±500 N, Tx,Ty,Tz ±3 Nm.
       Cutoff uses conservative axis. Noise from datasheet RMS. -->
  <sensor>
    <force name="ft_force" site="ft_sensor_site" cutoff="125" noise="0.06"/>
    <torque name="ft_torque" site="ft_sensor_site" cutoff="3" noise="0.003"/>
  </sensor>
</mujoco>
